# Add only PIX_* variables to the environment of the Brazilian operation.
# Do not replace Portugal's STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET or database.
# These values are intentionally blank: this file cannot activate payments.
PIX_ENABLED=false
PIX_STRIPE_PLATFORM_COUNTRY=BR
PIX_STRIPE_SECRET_KEY=
PIX_STRIPE_WEBHOOK_SECRET=
PIX_STRIPE_PAYMENT_METHOD_CONFIGURATION=
# Preserve the existing FRONTEND_URL and PAYMENT_ALLOWED_ORIGINS.
# Authorize only the real HTTPS frontend origin(s), without a path or credentials.
